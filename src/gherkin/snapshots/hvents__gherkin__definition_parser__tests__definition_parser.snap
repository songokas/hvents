  "Store temperatures mqtt message from topic \"temperatures/+/get\"":
    name: "Store temperatures mqtt message from topic \"temperatures/+/get\""
    mqtt_subscribe:
      topic: temperatures/+/get
      pool_id: ""
      fuzzy_threshold: 0.75
    next_event: "Store temperatures replace state key \"{{ metadata.topic_segments.1 }}_temperature\" with value \"{{ data }}\""
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
