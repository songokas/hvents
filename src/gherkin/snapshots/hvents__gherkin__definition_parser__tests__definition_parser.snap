  "Send temperature periodically execute \"shuf\" with args \"-i 10-22 -n 1\"":
    name: "Send temperature periodically execute \"shuf\" with args \"-i 10-22 -n 1\""
    execute:
      command: shuf
      args:
        - "-i"
        - 10-22
        - "-n"
        - "1"
      replace_args: {}
      vars: {}
      data_type: string
    next_event: "Send temperature periodically mqtt publish \"{{data}}\" to \"temperatures/bathroom/get\""
