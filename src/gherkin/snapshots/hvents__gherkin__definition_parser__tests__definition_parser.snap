---
- "Turn on ac periodically every \"in 20 seconds\"bathroom,20":
    name: "Turn on ac periodically every \"in 20 seconds\"bathroom,20"
    repeat:
      execute_time: hidden
      event_id: ~
    next_event: "Turn on ac periodically state key \"bathroom_temperature\" is below \"20\"bathroom,20"
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Turn on ac periodically state key \"bathroom_temperature\" is below \"20\"bathroom,20":
    name: "Turn on ac periodically state key \"bathroom_temperature\" is below \"20\"bathroom,20"
    comparison:
      data_to_compare: State
      key: bathroom_temperature
      operation: Lt
      value: "20"
    next_event: "Turn on ac periodically state key \"bathroom_internal_state\" is equal to \"off\"bathroom,20"
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Turn on ac periodically state key \"bathroom_internal_state\" is equal to \"off\"bathroom,20":
    name: "Turn on ac periodically state key \"bathroom_internal_state\" is equal to \"off\"bathroom,20"
    comparison:
      data_to_compare: State
      key: bathroom_internal_state
      operation: Equal
      value: "off"
    next_event: "Turn on ac periodically mqtt publish to topic \"rooms/bathroom/set\" with body \"1\"bathroom,20"
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Turn on ac periodically mqtt publish to topic \"rooms/bathroom/set\" with body \"1\"bathroom,20":
    name: "Turn on ac periodically mqtt publish to topic \"rooms/bathroom/set\" with body \"1\"bathroom,20"
    mqtt_publish:
      topic: rooms/bathroom/set
      body: "1"
      retain: false
      pool_id: ""
    next_event: "Turn on ac periodically replace state key \"bathroom_internal_state\" with value \"on\"bathroom,20"
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Turn on ac periodically replace state key \"bathroom_internal_state\" with value \"on\"bathroom,20":
    name: "Turn on ac periodically replace state key \"bathroom_internal_state\" with value \"on\"bathroom,20"
    forward: ~
    next_event: "Turn on ac periodically print to stdout \"Ac is on\"bathroom,20"
    metadata: ~
    state:
      count: ~
      replace:
        bathroom_internal_state: "on"
    data: ~
    merge_data: yes_if_empty
  "Turn on ac periodically print to stdout \"Ac is on\"bathroom,20":
    name: "Turn on ac periodically print to stdout \"Ac is on\"bathroom,20"
    print:
      template: Ac is on
      output: stdout
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
