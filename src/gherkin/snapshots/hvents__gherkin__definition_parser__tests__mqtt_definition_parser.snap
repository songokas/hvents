  "Active during daytime only mqtt message from topic \"home/sensor\"":
    name: "Active during daytime only mqtt message from topic \"home/sensor\""
    mqtt_subscribe:
      topic: home/sensor
      pool_id: ""
      fuzzy_threshold: 0.75
    next_event: "Active during daytime only between \"08:00\" and \"22:00\""
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Active during daytime only between \"08:00\" and \"22:00\"":
    name: "Active during daytime only between \"08:00\" and \"22:00\""
    period:
      from:
        time:
          - "08:00:00"
          - "08:00"
      to:
        time:
          - "22:00:00"
          - "22:00"
    next_event: "Active during daytime only print to stdout \"Daytime sensor: {{data}}\""
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Active during daytime only print to stdout \"Daytime sensor: {{data}}\"":
