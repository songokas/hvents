    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Send request every \"in 12 seconds\"":
    name: "Send request every \"in 12 seconds\""
    repeat:
      execute_time: hidden
      event_id: ~
    next_event: "Send request http post \"Hello\" to \"http://127.0.0.1:23323/api\" expect text"
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Send request http post \"Hello\" to \"http://127.0.0.1:23323/api\" expect text":
    name: "Send request http post \"Hello\" to \"http://127.0.0.1:23323/api\" expect text"
