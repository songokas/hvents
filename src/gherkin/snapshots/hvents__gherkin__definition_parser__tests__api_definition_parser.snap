    name: "Fetch status http get \"http://127.0.0.1:23323/status\""
    api_call:
      url: "http://127.0.0.1:23323/status"
      headers: {}
      method: get
      request_body: ~
      request_content: bytes
      response_content: text
      pool_id: ""
    next_event: "Fetch status print to stdout \"Response received from status {{data}}\""
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Fetch status print to stdout \"Response received from status {{data}}\"":
