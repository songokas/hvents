    name: "Fetch status every \"in 10 seconds\""
    repeat:
      execute_time: hidden
      event_id: ~
    next_event: "Fetch status http get \"http://127.0.0.1:23323/status\""
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
