---
source: src/gherkin/definition_parser.rs
expression: events
snapshot_kind: text
---
- "Listen for an api call http \"/status\" is called respond with \"OK\"":
    name: "Listen for an api call http \"/status\" is called respond with \"OK\""
    api_listen:
      path: /status
      method: get
      request_content: bytes
      request_headers: []
      response_headers: {}
      response_body: OK
      response_content: text
      action: start
      pool_id: ""
    next_event: "Listen for an api call print to stdout \"Status called\""
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Listen for an api call print to stdout \"Status called\"":
    name: "Listen for an api call print to stdout \"Status called\""
    print:
      template: Status called
      output: stdout
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Listen for an api call http \"/api\" is called with post and text respond with \"Hey\"":
    name: "Listen for an api call http \"/api\" is called with post and text respond with \"Hey\""
    api_listen:
      path: /api
      method: post
      request_content: text
      request_headers: []
      response_headers: {}
      response_body: Hey
      response_content: text
      action: start
      pool_id: ""
    next_event: "Listen for an api call print to stdout \"Data received {{data}}\""
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
  "Listen for an api call print to stdout \"Data received {{data}}\"":
    name: "Listen for an api call print to stdout \"Data received {{data}}\""
    print:
      template: "Data received {{data}}"
      output: stdout
    metadata: ~
    state: ~
    data: ~
    merge_data: yes_if_empty
